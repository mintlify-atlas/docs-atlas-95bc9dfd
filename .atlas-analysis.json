  "keyFeatures": [
    "Role-based access control (Admin / User)",
    "Trip creation and management with cost and distance tracking",
    "Collaborator (employee) management with branch assignments",
    "Branch (sucursal) management across multiple locations",
    "Transporter management with rate tracking",
    "Trip reports with joined data across users, branches, and transporters",
    "Session-based authentication with bcrypt password support",
    "Soft-delete pattern for collaborators (cl_estado flag)"
  ],
  "publicApiSurface": [
    "POST /user/login",
    "GET /cerrar (logout)",
    "GET /viajes",
    "GET /viajes/:id (get collaborators by branch)",
    "GET /viajes/distancia/:cedula/:sucursal",
    "POST /viajes/create",
    "GET /colaboradores",
    "POST /colaboradores/create",
    "GET /colaboradores/update/:id",
    "POST /colaboradores/update",
    "POST /colaboradores/delete/:id",
    "GET /sucursales",
    "POST /sucursales/create",
    "GET /sucursales/update/:id",
    "POST /sucursales/update",
    "POST /sucursales/delete/:id",
    "GET /transportistas",
    "POST /transportistas/create",
    "GET /transportistas/update/:id",
    "POST /transportistas/update",
    "POST /transportistas/delete/:id",
    "GET /reportes"
  ]
}
