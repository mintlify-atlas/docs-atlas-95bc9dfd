            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Authentication",
            "pages": ["api/login", "api/logout"]
          },
          {
            "group": "Trips",
            "pages": ["api/trips/list", "api/trips/create", "api/trips/distance"]
          },
          {
            "group": "Collaborators",
            "pages": ["api/collaborators/list", "api/collaborators/create", "api/collaborators/update", "api/collaborators/delete"]
          },
