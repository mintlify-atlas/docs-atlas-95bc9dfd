  "projectName": "Sistema Viajes (TRC)",
  "projectDescription": "A web-based employee transportation management system for tracking trips, collaborators, branches, and transporters with role-based access control.",
  "theme": "linden",
  "primaryColor": "#848c8e",
  "lightColor": "#11161e",
  "darkColor": "#cfd0d2",
